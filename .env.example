# Database connection URL (br_company_db container on port 5433)
APP_DATABASE_URL=postgresql://br_company:br_company_secret@localhost:5433/br_company

# Database schema to target (default: registry)
APP_DB_SCHEMA=registry

# Connection pool settings
APP_DB_POOL_MIN_SIZE=4
APP_DB_POOL_MAX_SIZE=20
APP_DB_POOL_TIMEOUT=30.0

# Server settings
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# CORS Origins (comma-separated or JSON list)
APP_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
